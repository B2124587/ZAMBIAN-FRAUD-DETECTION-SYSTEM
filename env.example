# Copy this file to .env and fill in real values. Never commit .env.

# ── Database ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=mobile_money_fraud

# ── PII hashing ──
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Changing this later invalidates all previously hashed MSISDNs in the DB,
# so set it once, before you first seed the database.
MSISDN_HASH_SECRET=change-me

# ── API auth ──
# Comma-separated list of valid API keys for the /score and /audit endpoints.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FRAUD_API_KEYS=change-me

# ── Flask ──
# Leave false/unset in production. Only set true for local debugging.
FLASK_DEBUG=false
PORT=5000
